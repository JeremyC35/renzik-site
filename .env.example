# Copy to .env.local for local testing. Never commit real values.

# Resend API key (resend.com → API Keys). Sending access only is enough.
RESEND_API_KEY=
# Inbox that receives leads. Until the domain is verified in Resend, this must be the Resend account owner's email.
CONTACT_TO_EMAIL=
# Sender. onboarding@resend.dev until the domain is verified, then e.g. leads@<domain>.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Upstash Redis REST credentials (upstash.com → database → REST API). Required on Vercel; the form returns 503 without them.
# Locally, leaving these empty falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated origins allowed to POST /api/contact (preview URL now, domain later). No trailing slash.
ALLOWED_ORIGINS=http://localhost:3000
# Canonical site URL for metadata, sitemap and robots. Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
